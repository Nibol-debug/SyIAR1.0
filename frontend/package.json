{
  "name": "syiar-frontend",
  "version": "1.0.0",
  "description": "Frontend for SyIAR Gemilang",
  "main": "server.js",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/public/styles.css -o ./src/public/css/main.css --minify",
    "dev:css": "npx tailwindcss -i ./src/public/styles.css -o ./src/public/css/main.css --watch",
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"npm run dev:css\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.0",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.17.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19"
  }
}
