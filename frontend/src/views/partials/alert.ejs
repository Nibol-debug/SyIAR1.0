<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="mb-6 p-4 rounded-xl bg-green-50 border border-green-200 flex items-center gap-3 text-green-700 animate-fade-in">
        <span class="material-symbols-outlined">check_circle</span>
        <p class="text-sm font-medium"><%= success %></p>
    </div>
<% } %>

<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 flex items-center gap-3 text-red-700 animate-fade-in">
        <span class="material-symbols-outlined">error</span>
        <p class="text-sm font-medium"><%= error %></p>
    </div>
<% } %>

<style>
@keyframes fade-in {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}
.animate-fade-in {
    animation: fade-in 0.3s ease-out forwards;
}
</style>
