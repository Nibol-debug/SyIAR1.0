<%- include('../layouts/main') %>

<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Data Santri</h1>
        <a href="/santri/create" class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-lg">
            + Tambah Santri
        </a>
    </div>
    
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">NIS</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nama</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Kelas</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Aksi</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <% if (santri.length === 0) { %>
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                            Belum ada data santri. <a href="/santri/create" class="text-teal-600">Tambah sekarang</a>
                        </td>
                    </tr>
                <% } %>
                <% santri.forEach(s => { %>
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 text-sm text-gray-900"><%= s.nis %></td>
                        <td class="px-6 py-4 text-sm text-gray-900"><%= s.nama_lengkap %></td>
                        <td class="px-6 py-4 text-sm text-gray-600"><%= s.kelas %></td>
                        <td class="px-6 py-4">
                            <span class="px-2 py-1 text-xs rounded-full <%= s.status === 'aktif' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                                <%= s.status %>
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right text-sm">
                            <a href="/santri/<%= s.id %>/edit" class="text-blue-600 hover:text-blue-800 mr-3">Edit</a>
                            <button onclick="deleteSantri(<%= s.id %>)" class="text-red-600 hover:text-red-800">Hapus</button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<script>
function deleteSantri(id) {
    if(confirm('Yakin ingin menghapus santri ini?')) {
        fetch(`/santri/${id}`, { method: 'DELETE', headers: { 'X-CSRF-Token': '<%= csrfToken %>' } })
            .then(() => window.location.reload());
    }
}
</script>
