<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <%- include('../partials/head') %>
</head>
<body class="font-sans text-on-surface">

<% var _currentPath = '/presensi-pegawai'; %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<main class="ml-64 p-8 min-h-screen">
    <div class="mb-6 flex justify-between items-end">
        <div>
            <a href="/presensi-pegawai" class="text-sm text-slate-500 hover:text-primary flex items-center gap-1 mb-4">
                <span class="material-symbols-outlined text-lg">arrow_back</span> Kembali ke Input Presensi
            </a>
            <h1 class="text-2xl font-bold text-on-surface">Rekap Presensi Pegawai</h1>
            <p class="text-sm text-slate-500 mt-1">Laporan kehadiran guru dan staf per bulan</p>
        </div>
    </div>

    <!-- Filter -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-6">
        <form method="GET" class="flex gap-4 items-end" id="filterForm">
            <div>
                <label class="text-xs text-slate-500 font-medium mb-1 block">Bulan</label>
                <input type="month" name="bulan" value="<%= filters?.bulan %>" required
                    class="px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 w-48"
                    onchange="document.getElementById('filterForm').submit()">
            </div>
        </form>
    </div>

    <!-- Table Rekap -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="w-full text-sm">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left font-semibold text-slate-500">Tanggal</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-500">Nama Pegawai</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-500">Status</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-500">Jam Masuk</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-500">Jam Keluar</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-500">Keterangan</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% if (!rekap || rekap.length === 0) { %>
                    <tr><td colspan="6" class="px-4 py-8 text-center text-slate-400">Tidak ada data rekap bulan ini</td></tr>
                    <% } else { %>
                        <% rekap.forEach(function(r) { %>
                        <tr class="hover:bg-slate-50/50">
                            <td class="px-4 py-3"><%= r.tanggal %></td>
                            <td class="px-4 py-3 font-medium text-slate-700"><%= r.nama_lengkap %></td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-1 rounded-full text-xs font-semibold
                                    <%= r.status === 'hadir' ? 'bg-emerald-50 text-emerald-700' :
                                        r.status === 'izin' ? 'bg-blue-50 text-blue-700' :
                                        r.status === 'sakit' ? 'bg-amber-50 text-amber-700' :
                                        r.status === 'alpha' ? 'bg-red-50 text-red-700' :
                                        'bg-slate-100 text-slate-600' %> uppercase">
                                    <%= r.status %>
                                </span>
                            </td>
                            <td class="px-4 py-3 text-slate-500"><%= r.jam_masuk || '-' %></td>
                            <td class="px-4 py-3 text-slate-500"><%= r.jam_keluar || '-' %></td>
                            <td class="px-4 py-3 text-slate-500"><%= r.keterangan || '-' %></td>
                        </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</main>
</body>
</html>
