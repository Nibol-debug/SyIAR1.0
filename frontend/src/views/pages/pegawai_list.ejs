<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <%- include('../partials/head') %>
</head>
<body class="font-sans text-on-surface">

<% var _currentPath = '/pegawai'; %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<main class="ml-64 p-8 min-h-screen">
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-2xl font-bold text-on-surface"><%= title %></h1>
                <p class="text-sm text-slate-500 mt-1">Kelola data guru dan staf</p>
            </div>
            <a href="/pegawai/create" class="px-4 py-2.5 bg-primary text-white rounded-lg hover:opacity-90 transition text-sm font-medium flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">person_add</span> Tambah Pegawai
            </a>
        </div>

        <!-- Filter -->
        <form method="GET" class="flex gap-3 mb-6 items-center flex-wrap">
            <input type="text" name="search" value="<%= filters?.search || '' %>" placeholder="Cari nama / NIP..."
                class="px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 w-64">
            <select name="status_kepegawaian" class="px-3 py-2 border border-slate-200 rounded-lg text-sm">
                <option value="">Semua Status</option>
                <% ['Tetap', 'GTT', 'PTT', 'Honorer'].forEach(function(s) { %>
                    <option value="<%= s %>" <%= filters?.status_kepegawaian === s ? 'selected' : '' %>><%= s %></option>
                <% }); %>
            </select>
            <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium">Filter</button>
        </form>

        <!-- Table -->
        <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="w-full">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Nama</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">JK</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Jabatan</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Pendidikan</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% if (!pegawaiList || pegawaiList.length === 0) { %>
                    <tr><td colspan="6" class="px-4 py-8 text-center text-slate-400">Tidak ada data pegawai</td></tr>
                    <% } %>
                    <% if (pegawaiList) pegawaiList.forEach(function(p) { %>
                    <tr class="hover:bg-slate-50/50">
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-full bg-gradient-to-br from-primary to-indigo-500 flex items-center justify-center text-white text-sm font-bold">
                                    <%= (p.nama_lengkap || '?')[0].toUpperCase() %>
                                </div>
                                <div>
                                    <p class="text-sm font-semibold"><%= p.nama_lengkap %></p>
                                    <p class="text-xs text-slate-400"><%= p.nip || '-' %></p>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3 text-sm"><%= p.jenis_kelamin %></td>
                        <td class="px-4 py-3 text-sm text-slate-600"><%= p.jabatan || '-' %></td>
                        <td class="px-4 py-3 text-sm">
                            <span class="px-2 py-1 rounded-full text-xs font-semibold
                                <%= p.status_kepegawaian === 'Tetap' ? 'bg-emerald-50 text-emerald-700' :
                                    p.status_kepegawaian === 'GTT' ? 'bg-blue-50 text-blue-700' :
                                    p.status_kepegawaian === 'PTT' ? 'bg-amber-50 text-amber-700' :
                                    'bg-slate-100 text-slate-600' %>">
                                <%= p.status_kepegawaian %>
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm text-slate-600"><%= p.pendidikan_terakhir || '-' %></td>
                        <td class="px-4 py-3 text-sm flex gap-1">
                            <a href="/pegawai/<%= p.id %>" class="p-1.5 rounded-lg hover:bg-primary/10 text-primary">
                                <span class="material-symbols-outlined text-lg">visibility</span>
                            </a>
                            <button onclick="deletePegawai('<%= p.id %>', '<%= p.nama_lengkap %>')" class="p-1.5 rounded-lg hover:bg-red-50 text-red-600">
                                <span class="material-symbols-outlined text-lg">delete</span>
                            </button>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<script>
function deletePegawai(id, name) {
    if (confirm('Hapus pegawai "' + name + '"?')) {
        fetch('/pegawai/' + id, { method: 'DELETE', headers: { 'Accept': 'application/json' }})
            .then(r => r.json()).then(d => { if(d.success) location.reload(); else alert(d.message); });
    }
}
</script>
</body>
</html>
