<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <%- include('../partials/head') %>
</head>
<body class="font-sans text-on-surface">

<% var _currentPath = '/santri'; %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<main class="ml-64 p-8 min-h-screen">
    <div class="max-w-4xl mx-auto">
        <div class="mb-6 flex items-center justify-between">
            <a href="/santri" class="text-sm text-slate-500 hover:text-primary flex items-center gap-1">
                <span class="material-symbols-outlined text-lg">arrow_back</span> Kembali
            </a>
            <div class="flex gap-2">
                <% if (permissions?.includes('santri.update') || user?.role === 'super_admin') { %>
                <a href="/santri/<%= santri.id %>/edit" class="px-4 py-2 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition text-sm font-medium flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg">edit</span> Edit
                </a>
                <% } %>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-primary to-primary-container p-6 text-white">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center text-2xl font-bold">
                        <%= (santri.nama_lengkap || 'S')[0].toUpperCase() %>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold"><%= santri.nama_lengkap %></h1>
                        <p class="text-white/80 text-sm"><%= santri.nis %> · <%= santri.jenis_kelamin === 'L' ? 'Laki-laki' : 'Perempuan' %></p>
                        <span class="inline-block mt-2 px-3 py-1 rounded-full text-xs font-semibold bg-white/20">
                            <%= santri.status ? santri.status.charAt(0).toUpperCase() + santri.status.slice(1) : 'Aktif' %>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Info Grid -->
            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <h3 class="text-sm font-bold text-primary flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg">person</span> Data Pribadi
                    </h3>
                    <div class="space-y-3">
                        <div class="flex"><span class="w-36 text-xs text-slate-500">Nama Panggilan</span><span class="text-sm font-medium"><%= santri.nama_panggilan || '-' %></span></div>
                        <div class="flex"><span class="w-36 text-xs text-slate-500">NISN</span><span class="text-sm font-medium font-mono"><%= santri.nisn || '-' %></span></div>
                        <div class="flex"><span class="w-36 text-xs text-slate-500">Tempat, Tgl Lahir</span><span class="text-sm font-medium"><%= santri.tempat_lahir || '-' %>, <%= santri.tanggal_lahir || '-' %></span></div>
                        <div class="flex"><span class="w-36 text-xs text-slate-500">Alamat</span><span class="text-sm font-medium"><%= santri.alamat || '-' %></span></div>
                        <div class="flex"><span class="w-36 text-xs text-slate-500">No. Telepon</span><span class="text-sm font-medium"><%= santri.no_telepon || '-' %></span></div>
                        <div class="flex"><span class="w-36 text-xs text-slate-500">Email</span><span class="text-sm font-medium"><%= santri.email || '-' %></span></div>
                        <div class="flex"><span class="w-36 text-xs text-slate-500">Kelas</span><span class="text-sm font-medium"><%= santri.kelas_id || '-' %></span></div>
                        <div class="flex"><span class="w-36 text-xs text-slate-500">Tanggal Masuk</span><span class="text-sm font-medium"><%= santri.tanggal_masuk || '-' %></span></div>
                    </div>
                </div>

                <div class="space-y-4">
                    <h3 class="text-sm font-bold text-primary flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg">family_restroom</span> Data Orang Tua
                    </h3>
                    <div class="space-y-3">
                        <div class="flex"><span class="w-36 text-xs text-slate-500">Nama Ayah</span><span class="text-sm font-medium"><%= santri.nama_ayah || '-' %></span></div>
                        <div class="flex"><span class="w-36 text-xs text-slate-500">Nama Ibu</span><span class="text-sm font-medium"><%= santri.nama_ibu || '-' %></span></div>
                        <div class="flex"><span class="w-36 text-xs text-slate-500">No. HP Ortu</span><span class="text-sm font-medium"><%= santri.no_hp_ortu || '-' %></span></div>
                        <div class="flex"><span class="w-36 text-xs text-slate-500">Pekerjaan</span><span class="text-sm font-medium"><%= santri.pekerjaan_ortu || '-' %></span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

</body>
</html>
