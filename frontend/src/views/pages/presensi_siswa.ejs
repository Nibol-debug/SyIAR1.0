<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <%- include('../partials/head') %>
</head>
<body class="font-sans text-on-surface">

<% var _currentPath = '/presensi'; %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<main class="ml-64 p-8 min-h-screen">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-on-surface"><%= title %></h1>
            <p class="text-sm text-slate-500 mt-1">Input kehadiran santri harian</p>
        </div>
        <a href="/presensi/rekap" class="px-4 py-2 bg-slate-100 text-slate-600 rounded-lg text-sm font-medium hover:bg-slate-200 transition flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">leaderboard</span> Lihat Rekap
        </a>
    </div>

    <!-- Filter -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-6">
        <form method="GET" class="flex gap-4 items-end flex-wrap">
            <div>
                <label class="text-xs text-slate-500 font-medium mb-1 block">Kelas</label>
                <select name="kelas_id" required class="px-3 py-2 border border-slate-200 rounded-lg text-sm" onchange="this.form.submit()">
                    <option value="">-- Pilih Kelas --</option>
                    <% if (typeof kelas !== 'undefined') kelas.forEach(function(k) { %>
                        <option value="<%= k.id %>" <%= filters?.kelas_id == k.id ? 'selected' : '' %>><%= k.nama_kelas %> - <%= k.tingkat %></option>
                    <% }); %>
                </select>
            </div>
            <div>
                <label class="text-xs text-slate-500 font-medium mb-1 block">Tanggal</label>
                <input type="date" name="tanggal" value="<%= filters?.tanggal || '' %>" class="px-3 py-2 border border-slate-200 rounded-lg text-sm" onchange="this.form.submit()">
            </div>
        </form>
    </div>

    <!-- Presensi Form -->
    <% if (typeof presensiData !== 'undefined' && presensiData.length > 0) { %>
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <form method="POST" action="/presensi/save">
            <input type="hidden" name="kelas_id" value="<%= filters?.kelas_id %>">
            <input type="hidden" name="tanggal" value="<%= filters?.tanggal %>">

            <div class="flex justify-between items-center mb-4">
                <h2 class="font-bold text-lg flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">groups</span>
                    <%= presensiData.length %> Santri
                </h2>
                <div class="flex gap-2 text-xs">
                    <button type="button" onclick="setAll('H')" class="px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-lg font-medium hover:bg-emerald-100">Semua H</button>
                    <button type="button" onclick="setAll('I')" class="px-3 py-1.5 bg-blue-50 text-blue-700 rounded-lg font-medium hover:bg-blue-100">Semua I</button>
                    <button type="button" onclick="setAll('S')" class="px-3 py-1.5 bg-amber-50 text-amber-700 rounded-lg font-medium hover:bg-amber-100">Semua S</button>
                </div>
            </div>

            <div class="overflow-x-auto rounded-lg border border-slate-200">
                <table class="w-full">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase w-12">#</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">NIS</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Nama Santri</th>
                            <th class="px-4 py-3 text-center text-xs font-semibold text-slate-500 uppercase" colspan="4">Status</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Ket.</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% presensiData.forEach(function(p, idx) { %>
                        <tr class="hover:bg-slate-50/50">
                            <td class="px-4 py-2 text-sm text-slate-400"><%= idx + 1 %></td>
                            <td class="px-4 py-2 text-sm font-mono"><%= p.nis || '-' %></td>
                            <td class="px-4 py-2 text-sm font-medium"><%= p.nama_lengkap %></td>
                            <% ['H', 'I', 'S', 'A'].forEach(function(st) { %>
                            <td class="px-2 py-2 text-center">
                                <label class="inline-flex items-center cursor-pointer">
                                    <input type="radio" name="status[<%= p.santri_id %>]" value="<%= st %>" 
                                        class="status-radio sr-only peer" data-santri="<%= p.santri_id %>"
                                        <%= p.status === st ? 'checked' : '' %>>
                                    <span class="w-8 h-8 rounded-lg flex items-center justify-center text-xs font-bold 
                                        peer-checked:<%= st === 'H' ? 'bg-emerald-500 text-white' : 
                                            st === 'I' ? 'bg-blue-500 text-white' : 
                                            st === 'S' ? 'bg-amber-500 text-white' : 
                                            'bg-red-500 text-white' %> 
                                        bg-slate-100 text-slate-500 hover:bg-slate-200 transition"><%= st %></span>
                                </label>
                            </td>
                            <% }); %>
                            <td class="px-2 py-2">
                                <input type="text" name="keterangan_item[<%= p.santri_id %>]" value="<%= p.keterangan || '' %>"
                                    placeholder="-" class="w-28 px-2 py-1 border border-slate-200 rounded text-xs">
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <div class="mt-6">
                <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg font-medium text-sm hover:bg-primary/90 transition flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg">save</span> Simpan Presensi
                </button>
            </div>
        </form>
    </div>
    <% } else if (filters?.kelas_id) { %>
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-12 text-center text-slate-400">
        <span class="material-symbols-outlined text-5xl mb-3">group_off</span>
        <p>Tidak ada santri di kelas ini.</p>
    </div>
    <% } else { %>
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-12 text-center text-slate-400">
        <span class="material-symbols-outlined text-5xl mb-3">fact_check</span>
        <p>Pilih kelas dan tanggal untuk mulai input presensi.</p>
    </div>
    <% } %>
</main>

<script>
function setAll(status) {
    document.querySelectorAll('input[type="radio"][value="' + status + '"]').forEach(r => r.checked = true);
}
</script>
</body>
</html>
