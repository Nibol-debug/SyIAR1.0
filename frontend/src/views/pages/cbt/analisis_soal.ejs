<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <%- include('../../partials/head') %>
</head>
<body class="font-sans text-on-surface">

<%- include('../../partials/sidebar', { _currentPath: '/cbt/analisis-soal' }) %>
<%- include('../../partials/topbar') %>

<main class="ml-64 p-8 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-slate-800">Analisis Butir Soal</h1>
            <p class="text-slate-500 mt-1">Laporan evaluasi kualitas instrumen soal ujian berdasarkan hasil pengerjaan siswa</p>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-8">
            <form action="/cbt/analisis-soal" method="GET" class="flex flex-col md:flex-row gap-4 mb-6">
                <div class="flex-1">
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Pilih Ujian</label>
                    <select name="ujian_id" class="w-full border-slate-200 rounded-lg text-sm focus:ring-primary focus:border-primary">
                        <option value="">-- Pilih Ujian --</option>
                        <% ujian.forEach(u => { %>
                            <option value="<%= u.id %>" <%= selectedUjianId == u.id ? 'selected' : '' %>><%= u.judul %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="flex items-end">
                    <button type="submit" class="bg-primary hover:bg-primary-dark text-white px-6 py-2 rounded-lg font-medium transition-colors shadow-sm w-full md:w-auto">Tampilkan Analisis</button>
                </div>
            </form>

            <!-- Ringkasan Statistik -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 pt-6 border-t border-slate-100">
                <div class="p-4 bg-slate-50 rounded-lg border border-slate-100">
                    <p class="text-slate-500 text-xs font-semibold uppercase tracking-wide mb-1">Total Soal</p>
                    <p class="text-2xl font-bold text-slate-800"><%= analisis.length %></p>
                </div>
                <div class="p-4 bg-slate-50 rounded-lg border border-slate-100">
                    <p class="text-slate-500 text-xs font-semibold uppercase tracking-wide mb-1">Status Analisis</p>
                    <p class="text-2xl font-bold text-slate-800"><%= analisis.length > 0 ? 'Siap' : '-' %></p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
                        <th class="p-4 font-semibold border-b w-16 text-center">No</th>
                        <th class="p-4 font-semibold border-b">Pertanyaan</th>
                        <th class="p-4 font-semibold border-b text-center">Peserta</th>
                        <th class="p-4 font-semibold border-b text-center">Benar</th>
                        <th class="p-4 font-semibold border-b text-center">Indeks Kesulitan</th>
                        <th class="p-4 font-semibold border-b text-center">Status</th>
                    </tr>
                </thead>
                <tbody class="text-sm divide-y divide-slate-100">
                    <% if (analisis.length > 0) { %>
                        <% analisis.forEach((a, idx) => { %>
                        <tr class="hover:bg-slate-50/50">
                            <td class="p-4 font-bold text-slate-600 text-center"><%= idx + 1 %></td>
                            <td class="p-4 text-slate-800">
                                <div class="max-w-md truncate" title="<%= a.pertanyaan %>"><%= a.pertanyaan %></div>
                                <div class="text-[10px] text-slate-400">ID: #<%= a.soal_id %></div>
                            </td>
                            <td class="p-4 text-center font-medium"><%= a.total_peserta %></td>
                            <td class="p-4 text-center text-green-600 font-bold"><%= a.total_benar %></td>
                            <td class="p-4 text-center">
                                <div class="flex flex-col items-center gap-1">
                                    <span class="px-2 py-1 rounded text-[10px] font-bold 
                                        <%= a.tingkat_kesulitan === 'Mudah' ? 'bg-green-100 text-green-700' : 
                                           (a.tingkat_kesulitan === 'Sedang' ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700') %>">
                                        <%= a.tingkat_kesulitan %>
                                    </span>
                                    <span class="text-xs font-medium text-slate-500"><%= a.persentase_benar %>%</span>
                                </div>
                            </td>
                            <td class="p-4 text-center">
                                <span class="<%= a.persentase_benar > 30 ? 'text-green-600' : 'text-red-600' %> font-semibold">
                                    <%= a.persentase_benar > 30 ? 'VALID' : 'REVISI' %>
                                </span>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="p-8 text-center text-slate-400">Pilih ujian untuk melihat analisis butir soal.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</main>

</body>
</html>
