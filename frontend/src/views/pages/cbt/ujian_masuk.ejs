<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <%- include('../../partials/head') %>
</head>
<body class="font-sans text-on-surface bg-slate-50">

<%- include('../../partials/sidebar', { _currentPath: '/cbt/ujian-siswa' }) %>
<%- include('../../partials/topbar') %>

<main class="ml-64 p-8 min-h-screen flex items-center justify-center">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
            <div class="p-8 text-center bg-primary text-white">
                <div class="w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center mx-auto mb-4 backdrop-blur-sm">
                    <span class="material-symbols-outlined text-4xl">vpn_key</span>
                </div>
                <h1 class="text-2xl font-bold">Masuk Ruang Ujian</h1>
                <p class="text-primary-container/80 text-sm mt-1">Masukkan token akses yang diberikan pengawas</p>
            </div>
            
            <div class="p-8">
                <%- include('../../partials/alert') %>
                
                <form id="entry-form" class="space-y-6">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">Token Akses</label>
                        <input type="text" id="token_akses" required placeholder="Contoh: UAS2026" 
                               class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-4 focus:ring-primary/10 focus:border-primary transition-all text-center text-2xl font-mono tracking-widest uppercase">
                    </div>

                    <div class="bg-amber-50 border border-amber-100 rounded-xl p-4 flex gap-3">
                        <span class="material-symbols-outlined text-amber-500">info</span>
                        <div class="text-xs text-amber-800 leading-relaxed">
                            Pastikan koneksi internet stabil. Jangan menutup tab browser setelah ujian dimulai untuk menghindari sanksi sistem.
                        </div>
                    </div>

                    <button type="submit" id="btn-submit" class="w-full bg-primary hover:bg-primary-dark text-white py-4 rounded-xl font-bold shadow-lg shadow-primary/20 transition-all flex items-center justify-center gap-2">
                        Mulai Ujian Sekarang
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </form>
            </div>
        </div>
        
        <p class="text-center text-slate-400 text-xs mt-8">
            &copy; 2026 SyIAR Gemilang ERP System. All Rights Reserved.
        </p>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
    document.getElementById('entry-form').onsubmit = async (e) => {
        e.preventDefault();
        const tokenAkses = document.getElementById('token_akses').value;
        const btn = document.getElementById('btn-submit');
        
        btn.disabled = true;
        btn.innerHTML = '<span class="animate-spin material-symbols-outlined">sync</span> Memvalidasi...';
        
        try {
            const res = await axios.post('http://localhost:8081/api/ujian-sesi/mulai', {
                token_akses: tokenAkses,
                santri_id: '<%= user.santri_id || 1 %>' // Fallback ke 1 jika bukan santri (untuk testing)
            }, {
                headers: { 'Authorization': 'Bearer <%= token %>' }
            });
            
            if (res.data.status === 200) {
                window.location.href = `/cbt/ujian-siswa?sesi_id=${res.data.data.sesi_id}`;
            }
        } catch (err) {
            alert(err.response?.data?.messages?.error || 'Token tidak valid atau ujian belum aktif');
            btn.disabled = false;
            btn.innerHTML = 'Mulai Ujian Sekarang <span class="material-symbols-outlined">arrow_forward</span>';
        }
    };
</script>

</body>
</html>
