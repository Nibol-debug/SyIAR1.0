<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <%- include('../partials/head') %>
</head>
<body class="font-sans text-on-surface">

<% var _currentPath = '/santri'; %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<main class="ml-64 p-8 min-h-screen">
    <div class="max-w-3xl mx-auto">
        <div class="mb-6">
            <a href="/santri" class="text-sm text-slate-500 hover:text-primary flex items-center gap-1">
                <span class="material-symbols-outlined text-lg">arrow_back</span> Kembali ke Data Santri
            </a>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8">
            <h1 class="text-2xl font-bold text-on-surface mb-6 flex items-center gap-3">
                <span class="material-symbols-outlined text-primary text-3xl"><%= mode === 'edit' ? 'edit' : 'person_add' %></span>
                <%= title %>
            </h1>

            <form action="<%= mode === 'edit' ? '/santri/' + santri.id : '/santri' %>" method="POST" class="space-y-6">

                <!-- Data Pribadi -->
                <fieldset class="border border-slate-200 rounded-xl p-6">
                    <legend class="text-sm font-bold text-primary px-2">Data Pribadi</legend>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Lengkap <span class="text-red-500">*</span></label>
                            <input type="text" name="nama_lengkap" value="<%= santri.nama_lengkap || '' %>" required minlength="3"
                                   class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Panggilan</label>
                            <input type="text" name="nama_panggilan" value="<%= santri.nama_panggilan || '' %>"
                                   class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Jenis Kelamin <span class="text-red-500">*</span></label>
                            <select name="jenis_kelamin" required class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20">
                                <option value="L" <%= santri.jenis_kelamin === 'L' ? 'selected' : '' %>>Laki-laki</option>
                                <option value="P" <%= santri.jenis_kelamin === 'P' ? 'selected' : '' %>>Perempuan</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Tempat Lahir</label>
                            <input type="text" name="tempat_lahir" value="<%= santri.tempat_lahir || '' %>"
                                   class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Tanggal Lahir <span class="text-red-500">*</span></label>
                            <input type="date" name="tanggal_lahir" value="<%= santri.tanggal_lahir || '' %>" required
                                   class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Kelas</label>
                            <select name="kelas_id" class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20">
                                <option value="">-- Pilih Kelas --</option>
                                <% if (typeof kelas !== 'undefined') kelas.forEach(k => { %>
                                    <option value="<%= k.id %>" <%= santri.kelas_id == k.id ? 'selected' : '' %>><%= k.nama_kelas %> - <%= k.jurusan %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="mt-4">
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Alamat</label>
                        <textarea name="alamat" rows="2" class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"><%= santri.alamat || '' %></textarea>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">No. Telepon</label>
                            <input type="tel" name="no_telepon" value="<%= santri.no_telepon || '' %>"
                                   class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Email</label>
                            <input type="email" name="email" value="<%= santri.email || '' %>"
                                   class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
                        </div>
                    </div>
                </fieldset>

                <!-- Data Orang Tua -->
                <fieldset class="border border-slate-200 rounded-xl p-6">
                    <legend class="text-sm font-bold text-primary px-2">Data Orang Tua</legend>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Ayah <span class="text-red-500">*</span></label>
                            <input type="text" name="nama_ayah" value="<%= santri.nama_ayah || '' %>" required
                                   class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Ibu <span class="text-red-500">*</span></label>
                            <input type="text" name="nama_ibu" value="<%= santri.nama_ibu || '' %>" required
                                   class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">No. HP Orang Tua</label>
                            <input type="tel" name="no_hp_ortu" value="<%= santri.no_hp_ortu || '' %>"
                                   class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Pekerjaan Orang Tua</label>
                            <input type="text" name="pekerjaan_ortu" value="<%= santri.pekerjaan_ortu || '' %>"
                                   class="w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
                        </div>
                    </div>
                </fieldset>

                <!-- Buttons -->
                <div class="flex justify-end gap-3 pt-4">
                    <a href="/santri" class="px-6 py-2.5 bg-slate-100 text-slate-700 rounded-lg hover:bg-slate-200 transition text-sm font-medium">Batal</a>
                    <button type="submit" class="px-6 py-2.5 bg-primary text-white rounded-lg hover:opacity-90 transition text-sm font-medium flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg">save</span>
                        <%= mode === 'edit' ? 'Update' : 'Simpan' %>
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

</body>
</html>
