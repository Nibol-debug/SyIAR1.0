<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <%- include('../partials/head') %>
</head>
<body class="font-sans text-on-surface">

<% var _currentPath = '/presensi'; %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<main class="ml-64 p-8 min-h-screen">
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div class="mb-6">
            <a href="/presensi" class="text-sm text-slate-500 hover:text-primary flex items-center gap-1 mb-4">
                <span class="material-symbols-outlined text-lg">arrow_back</span> Kembali
            </a>
            <h1 class="text-2xl font-bold text-on-surface"><%= title %></h1>
        </div>

        <!-- Filter -->
        <form method="GET" class="flex gap-3 mb-6 items-end flex-wrap">
            <div>
                <label class="text-xs text-slate-500 font-medium mb-1 block">Kelas</label>
                <select name="kelas_id" required class="px-3 py-2 border border-slate-200 rounded-lg text-sm">
                    <option value="">-- Pilih Kelas --</option>
                    <% if (typeof kelas !== 'undefined') kelas.forEach(function(k) { %>
                        <option value="<%= k.id %>" <%= filters?.kelas_id == k.id ? 'selected' : '' %>><%= k.nama_kelas %> - <%= k.jurusan %></option>
                    <% }); %>
                </select>
            </div>
            <div>
                <label class="text-xs text-slate-500 font-medium mb-1 block">Bulan</label>
                <input type="month" name="bulan" value="<%= filters?.bulan || '' %>" class="px-3 py-2 border border-slate-200 rounded-lg text-sm">
            </div>
            <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium">Tampilkan</button>
        </form>

        <!-- Rekap Table -->
        <% if (typeof rekap !== 'undefined' && rekap.length > 0) { %>
        <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="w-full">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">NIS</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Nama</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-emerald-600 uppercase">Hadir</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-blue-600 uppercase">Izin</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-amber-600 uppercase">Sakit</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-red-600 uppercase">Alpha</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-500 uppercase">% Hadir</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% rekap.forEach(function(r) { 
                        const total = parseInt(r.hadir||0) + parseInt(r.izin||0) + parseInt(r.sakit||0) + parseInt(r.alpha||0);
                        const pct = total > 0 ? Math.round((parseInt(r.hadir||0) / total) * 100) : 0;
                    %>
                    <tr class="hover:bg-slate-50/50">
                        <td class="px-4 py-3 text-sm font-mono"><%= r.nis %></td>
                        <td class="px-4 py-3 text-sm font-medium"><%= r.nama_lengkap %></td>
                        <td class="px-4 py-3 text-center text-sm font-bold text-emerald-600"><%= r.hadir || 0 %></td>
                        <td class="px-4 py-3 text-center text-sm font-bold text-blue-600"><%= r.izin || 0 %></td>
                        <td class="px-4 py-3 text-center text-sm font-bold text-amber-600"><%= r.sakit || 0 %></td>
                        <td class="px-4 py-3 text-center text-sm font-bold text-red-600"><%= r.alpha || 0 %></td>
                        <td class="px-4 py-3 text-center text-sm">
                            <span class="px-2 py-1 rounded-full text-xs font-bold
                                <%= pct >= 80 ? 'bg-emerald-50 text-emerald-700' : pct >= 60 ? 'bg-amber-50 text-amber-700' : 'bg-red-50 text-red-700' %>">
                                <%= pct %>%
                            </span>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else if (filters?.kelas_id) { %>
        <div class="text-center py-12 text-slate-400">
            <span class="material-symbols-outlined text-5xl mb-3">search_off</span>
            <p>Belum ada data presensi untuk bulan ini.</p>
        </div>
        <% } else { %>
        <div class="text-center py-12 text-slate-400">
            <span class="material-symbols-outlined text-5xl mb-3">leaderboard</span>
            <p>Pilih kelas dan bulan untuk melihat rekap.</p>
        </div>
        <% } %>
    </div>
</main>
</body>
</html>
