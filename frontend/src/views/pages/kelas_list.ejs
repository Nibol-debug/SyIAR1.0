<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <%- include('../partials/head') %>
</head>
<body class="font-sans text-on-surface">

<% var _currentPath = '/kelas'; %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<main class="ml-64 p-8 min-h-screen">
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-2xl font-bold text-on-surface"><%= title %></h1>
                <p class="text-sm text-slate-500 mt-1">Kelola data kelas dan kapasitas</p>
            </div>
            <button onclick="document.getElementById('addKelasForm').classList.toggle('hidden')" 
                    class="px-4 py-2.5 bg-primary text-white rounded-lg hover:opacity-90 transition text-sm font-medium flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">add</span> Tambah Kelas
            </button>
        </div>

        <!-- Add Kelas Form (hidden by default) -->
        <form id="addKelasForm" class="hidden mb-6 p-4 bg-slate-50 rounded-xl border border-slate-200" action="/kelas" method="POST">
            <h3 class="font-bold text-sm mb-3">Tambah Kelas Baru</h3>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                <input type="text" name="nama_kelas" placeholder="Nama Kelas (1A, 7B...)" required class="px-3 py-2 border border-slate-200 rounded-lg text-sm">
                <input type="text" name="jurusan" placeholder="Jurusan (IPA, IPS, Reguler...)" required class="px-3 py-2 border border-slate-200 rounded-lg text-sm">
                <input type="text" name="tahun_ajaran" placeholder="2025/2026" value="2025/2026" class="px-3 py-2 border border-slate-200 rounded-lg text-sm">
                <input type="number" name="kapasitas" placeholder="Kapasitas" value="30" class="px-3 py-2 border border-slate-200 rounded-lg text-sm">
                <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium">Simpan</button>
            </div>
        </form>

        <!-- Kelas Table -->
        <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="w-full">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Nama Kelas</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Jurusan</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Tahun Ajaran</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Kapasitas</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% if (!kelasList || kelasList.length === 0) { %>
                    <tr><td colspan="5" class="px-4 py-8 text-center text-slate-400">Tidak ada data kelas</td></tr>
                    <% } %>
                    <% if (kelasList) kelasList.forEach(function(k) { %>
                    <tr class="hover:bg-slate-50/50">
                        <td class="px-4 py-3 text-sm font-semibold"><%= k.nama_kelas %></td>
                        <td class="px-4 py-3 text-sm"><span class="px-2 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary"><%= k.jurusan || '-' %></span></td>
                        <td class="px-4 py-3 text-sm text-slate-600"><%= k.tahun_ajaran || '-' %></td>
                        <td class="px-4 py-3 text-sm text-slate-600"><%= k.kapasitas || 30 %></td>
                        <td class="px-4 py-3 text-sm">
                            <button onclick="deleteKelas('<%= k.id %>', '<%= k.nama_kelas %>')" class="p-1.5 rounded-lg hover:bg-red-50 text-red-600">
                                <span class="material-symbols-outlined text-lg">delete</span>
                            </button>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<script>
function deleteKelas(id, name) {
    if (confirm('Hapus kelas "' + name + '"?')) {
        fetch('/kelas/' + id, { method: 'DELETE', headers: { 'Accept': 'application/json' }})
            .then(r => r.json())
            .then(data => { if (data.success) location.reload(); else alert(data.message); })
            .catch(() => alert('Gagal menghubungi server'));
    }
}
</script>

</body>
</html>
