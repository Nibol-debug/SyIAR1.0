<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <%- include('../partials/head') %>
</head>
<body class="font-sans text-on-surface">

<% var _currentPath = '/santri'; %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<main class="ml-64 p-8 min-h-screen">
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-2xl font-bold text-on-surface"><%= title %></h1>
                <p class="text-sm text-slate-500 mt-1">Kelola data santri Al-Azhar Rumah Gemilang</p>
            </div>
            <div class="flex gap-2">
                <% if (permissions?.includes('santri.import') || user?.role === 'super_admin') { %>
                <a href="/santri/import" class="px-4 py-2.5 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition text-sm font-medium flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg">upload_file</span> Import
                </a>
                <% } %>
                <% if (permissions?.includes('santri.create') || user?.role === 'super_admin') { %>
                <a href="/santri/create" class="px-4 py-2.5 bg-primary text-white rounded-lg hover:opacity-90 transition text-sm font-medium flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg">person_add</span> Tambah Santri
                </a>
                <% } %>
            </div>
        </div>
        
        <!-- Filters -->
        <form class="flex gap-3 mb-6 flex-wrap items-end" method="GET">
            <div>
                <label class="text-xs text-slate-500 font-medium mb-1 block">Cari</label>
                <input type="text" name="search" placeholder="Nama / NIS..." 
                       value="<%= filters?.search || '' %>"
                       class="px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none w-48">
            </div>
            <div>
                <label class="text-xs text-slate-500 font-medium mb-1 block">Kelas</label>
                <select name="kelas_id" class="px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20">
                    <option value="">Semua Kelas</option>
                    <% if (typeof kelas !== 'undefined') kelas.forEach(k => { %>
                        <option value="<%= k.id %>" <%= filters?.kelas_id == k.id ? 'selected' : '' %>><%= k.nama_kelas %> - <%= k.jurusan %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="text-xs text-slate-500 font-medium mb-1 block">Status</label>
                <select name="status" class="px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/20">
                    <option value="">Semua Status</option>
                    <option value="aktif" <%= filters?.status === 'aktif' ? 'selected' : '' %>>Aktif</option>
                    <option value="lulus" <%= filters?.status === 'lulus' ? 'selected' : '' %>>Lulus</option>
                    <option value="pindah" <%= filters?.status === 'pindah' ? 'selected' : '' %>>Pindah</option>
                    <option value="keluar" <%= filters?.status === 'keluar' ? 'selected' : '' %>>Keluar</option>
                </select>
            </div>
            <button type="submit" class="px-4 py-2 bg-slate-700 text-white rounded-lg hover:bg-slate-800 transition text-sm font-medium flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">search</span> Filter
            </button>
            <% if (filters?.search || filters?.kelas_id || filters?.status) { %>
            <a href="/santri" class="px-4 py-2 bg-slate-100 text-slate-600 rounded-lg hover:bg-slate-200 transition text-sm">Reset</a>
            <% } %>
        </form>
        
        <!-- Table -->
        <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="w-full">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">NIS</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Nama Lengkap</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">JK</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Kelas</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% if (santris.length === 0) { %>
                    <tr><td colspan="6" class="px-4 py-8 text-center text-slate-400">Tidak ada data santri</td></tr>
                    <% } %>
                    <% santris.forEach(s => { %>
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="px-4 py-3 text-sm font-mono text-slate-600"><%= s.nis %></td>
                        <td class="px-4 py-3 text-sm">
                            <a href="/santri/<%= s.id %>" class="text-primary hover:underline font-medium"><%= s.nama_lengkap %></a>
                            <% if (s.nama_panggilan) { %>
                                <span class="text-slate-400 text-xs ml-1">(<%= s.nama_panggilan %>)</span>
                            <% } %>
                        </td>
                        <td class="px-4 py-3 text-sm">
                            <span class="inline-flex items-center gap-1 text-xs">
                                <span class="material-symbols-outlined text-sm"><%= s.jenis_kelamin === 'L' ? 'male' : 'female' %></span>
                                <%= s.jenis_kelamin === 'L' ? 'L' : 'P' %>
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm text-slate-600"><%= s.kelas_nama || s.kelas_id || '-' %></td>
                        <td class="px-4 py-3 text-sm">
                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold
                                <%= s.status === 'aktif' ? 'bg-emerald-50 text-emerald-700' : 
                                    s.status === 'lulus' ? 'bg-blue-50 text-blue-700' : 
                                    'bg-slate-100 text-slate-600' %>">
                                <%= s.status ? s.status.charAt(0).toUpperCase() + s.status.slice(1) : '-' %>
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm">
                            <div class="flex items-center gap-1">
                                <a href="/santri/<%= s.id %>" class="p-1.5 rounded-lg hover:bg-blue-50 text-blue-600" title="Detail">
                                    <span class="material-symbols-outlined text-lg">visibility</span>
                                </a>
                                <% if (permissions?.includes('santri.update') || user?.role === 'super_admin') { %>
                                <a href="/santri/<%= s.id %>/edit" class="p-1.5 rounded-lg hover:bg-amber-50 text-amber-600" title="Edit">
                                    <span class="material-symbols-outlined text-lg">edit</span>
                                </a>
                                <% } %>
                                <% if (permissions?.includes('santri.delete') || user?.role === 'super_admin') { %>
                                <button onclick="confirmDelete(<%= s.id %>, '<%= s.nama_lengkap %>')" class="p-1.5 rounded-lg hover:bg-red-50 text-red-600" title="Hapus">
                                    <span class="material-symbols-outlined text-lg">delete</span>
                                </button>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <% if (typeof pager !== 'undefined' && pager) { %>
        <div class="mt-4 flex justify-center gap-1">
            <p class="text-sm text-slate-500">Menampilkan <%= santris.length %> data</p>
        </div>
        <% } %>
    </div>
</main>

<script>
function confirmDelete(id, name) {
    if (confirm(`Yakin ingin menghapus santri "${name}"?`)) {
        fetch(`/santri/${id}`, { method: 'DELETE', headers: { 'Accept': 'application/json' }})
            .then(r => r.json())
            .then(data => {
                if (data.success) location.reload();
                else alert(data.message || 'Gagal menghapus');
            })
            .catch(() => alert('Gagal menghubungi server'));
    }
}
</script>

</body>
</html>
