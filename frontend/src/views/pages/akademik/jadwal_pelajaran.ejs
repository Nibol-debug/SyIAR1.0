<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <%- include('../../partials/head') %>
</head>
<body class="font-sans text-on-surface">

<%- include('../../partials/sidebar', { _currentPath: '/akademik/jadwal-pelajaran' }) %>
<%- include('../../partials/topbar') %>

<main class="ml-64 p-8 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-slate-800">Manajemen Jadwal Pelajaran</h1>
                <p class="text-slate-500 mt-1">Kelola jadwal pelajaran untuk setiap kelas</p>
            </div>
            <button onclick="document.getElementById('addModal').classList.remove('hidden')" class="btn-primary flex items-center gap-2">
                <span class="material-symbols-outlined">add</span>
                Tambah Jadwal
            </button>
        </div>

        <%- include('../../partials/alert') %>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 text-sm">
                        <th class="py-4 px-6 font-medium">Hari</th>
                        <th class="py-4 px-6 font-medium">Jam</th>
                        <th class="py-4 px-6 font-medium">Kelas</th>
                        <th class="py-4 px-6 font-medium">Mata Pelajaran</th>
                        <th class="py-4 px-6 font-medium">Guru</th>
                        <th class="py-4 px-6 font-medium">Ruang</th>
                        <th class="py-4 px-6 font-medium text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% if (jadwal && jadwal.length > 0) { %>
                        <% jadwal.forEach(item => { %>
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="py-4 px-6 font-medium text-slate-800"><%= item.hari %></td>
                                <td class="py-4 px-6"><%= item.jam_mulai %> - <%= item.jam_selesai %></td>
                                <td class="py-4 px-6"><%= item.nama_kelas %></td>
                                <td class="py-4 px-6"><%= item.nama_mapel %></td>
                                <td class="py-4 px-6"><%= item.nama_guru %></td>
                                <td class="py-4 px-6"><%= item.ruangan || '-' %></td>
                                <td class="py-4 px-6 text-right">
                                    <button class="text-red-500 hover:text-red-700 p-2" onclick="deleteJadwal(<%= item.id %>)">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="py-8 text-center text-slate-500">Belum ada data jadwal pelajaran.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<!-- Add Modal -->
<div id="addModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[100] flex items-center justify-center">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
            <h3 class="font-bold text-slate-800">Tambah Jadwal</h3>
            <button onclick="document.getElementById('addModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form action="/akademik/jadwal-pelajaran" method="POST" class="p-6">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Hari</label>
                    <select name="hari" required class="w-full px-4 py-2.5 rounded-lg border border-slate-200">
                        <option value="Senin">Senin</option>
                        <option value="Selasa">Selasa</option>
                        <option value="Rabu">Rabu</option>
                        <option value="Kamis">Kamis</option>
                        <option value="Jumat">Jumat</option>
                        <option value="Sabtu">Sabtu</option>
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Jam Mulai</label>
                        <input type="time" name="jam_mulai" required class="w-full px-4 py-2.5 rounded-lg border border-slate-200">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Jam Selesai</label>
                        <input type="time" name="jam_selesai" required class="w-full px-4 py-2.5 rounded-lg border border-slate-200">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Kelas</label>
                    <select name="kelas_id" required class="w-full px-4 py-2.5 rounded-lg border border-slate-200">
                        <% kelasList.forEach(k => { %>
                            <option value="<%= k.id %>"><%= k.nama_kelas %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Mata Pelajaran</label>
                    <select name="mapel_id" required class="w-full px-4 py-2.5 rounded-lg border border-slate-200">
                        <% mapelList.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.nama_mapel %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Guru Pengajar</label>
                    <select name="guru_id" required class="w-full px-4 py-2.5 rounded-lg border border-slate-200">
                        <% guruList.forEach(g => { %>
                            <option value="<%= g.id %>"><%= g.nama_lengkap %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Ruangan (Opsional)</label>
                    <input type="text" name="ruangan" placeholder="Contoh: Lab Komputer" class="w-full px-4 py-2.5 rounded-lg border border-slate-200">
                </div>
            </div>
            <div class="mt-8 flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('addModal').classList.add('hidden')" class="px-5 py-2.5 text-slate-600 font-medium hover:bg-slate-50 rounded-lg transition-colors">Batal</button>
                <button type="submit" class="btn-primary">Simpan Data</button>
            </div>
        </form>
    </div>
</div>

<script>
async function deleteJadwal(id) {
    if(!confirm('Yakin ingin menghapus data ini?')) return;
    try {
        const res = await fetch(`/akademik/jadwal-pelajaran/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if(data.success) location.reload();
        else alert(data.message || 'Gagal menghapus');
    } catch (e) {
        alert('Terjadi kesalahan');
    }
}
</script>

</body>
</html>
