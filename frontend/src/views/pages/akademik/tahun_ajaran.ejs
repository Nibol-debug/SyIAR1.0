<!DOCTYPE html>
<html class="light" lang="id">
<head>
    <%- include('../../partials/head') %>
</head>
<body class="font-sans text-on-surface">

<%- include('../../partials/sidebar', { _currentPath: '/akademik/tahun-ajaran' }) %>
<%- include('../../partials/topbar') %>

<main class="ml-64 p-8 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-slate-800">Manajemen Tahun Ajaran</h1>
                <p class="text-slate-500 mt-1">Kelola data tahun ajaran dan semester</p>
            </div>
            <button onclick="document.getElementById('addModal').classList.remove('hidden')" class="btn-primary flex items-center gap-2">
                <span class="material-symbols-outlined">add</span>
                Tambah Tahun Ajaran
            </button>
        </div>

        <%- include('../../partials/alert') %>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 text-sm">
                        <th class="py-4 px-6 font-medium">Kode</th>
                        <th class="py-4 px-6 font-medium">Nama</th>
                        <th class="py-4 px-6 font-medium">Semester</th>
                        <th class="py-4 px-6 font-medium">Periode</th>
                        <th class="py-4 px-6 font-medium">Status</th>
                        <th class="py-4 px-6 font-medium text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% if (tahunAjaran && tahunAjaran.length > 0) { %>
                        <% tahunAjaran.forEach(item => { %>
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="py-4 px-6"><span class="font-medium text-slate-800"><%= item.kode %></span></td>
                                <td class="py-4 px-6"><%= item.nama %></td>
                                <td class="py-4 px-6 capitalize"><%= item.semester %></td>
                                <td class="py-4 px-6 text-sm text-slate-500">
                                    <%= new Date(item.tanggal_mulai).toLocaleDateString('id-ID') %> - 
                                    <%= new Date(item.tanggal_selesai).toLocaleDateString('id-ID') %>
                                </td>
                                <td class="py-4 px-6">
                                    <% if (item.is_active == 1) { %>
                                        <span class="px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-medium">Aktif</span>
                                    <% } else { %>
                                        <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-medium">Nonaktif</span>
                                    <% } %>
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <button class="text-red-500 hover:text-red-700 p-2" onclick="deleteTahunAjaran(<%= item.id %>)">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="py-8 text-center text-slate-500">Belum ada data tahun ajaran.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<!-- Add Modal -->
<div id="addModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[100] flex items-center justify-center">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
            <h3 class="font-bold text-slate-800">Tambah Tahun Ajaran</h3>
            <button onclick="document.getElementById('addModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form action="/akademik/tahun-ajaran" method="POST" class="p-6">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Kode</label>
                    <input type="text" name="kode" required placeholder="Contoh: 2025/2026" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Nama</label>
                    <input type="text" name="nama" required placeholder="Contoh: Tahun Ajaran 2025/2026" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Semester</label>
                    <select name="semester" required class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                        <option value="ganjil">Ganjil</option>
                        <option value="genap">Genap</option>
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Tanggal Mulai</label>
                        <input type="date" name="tanggal_mulai" required class="w-full px-4 py-2.5 rounded-lg border border-slate-200">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Tanggal Selesai</label>
                        <input type="date" name="tanggal_selesai" required class="w-full px-4 py-2.5 rounded-lg border border-slate-200">
                    </div>
                </div>
                <div>
                    <label class="flex items-center gap-2 mt-2">
                        <input type="checkbox" name="is_active" value="1" class="rounded border-slate-300 text-primary focus:ring-primary">
                        <span class="text-sm text-slate-700">Jadikan Tahun Ajaran Aktif</span>
                    </label>
                </div>
            </div>
            <div class="mt-8 flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('addModal').classList.add('hidden')" class="px-5 py-2.5 text-slate-600 font-medium hover:bg-slate-50 rounded-lg transition-colors">Batal</button>
                <button type="submit" class="btn-primary">Simpan Data</button>
            </div>
        </form>
    </div>
</div>

<script>
async function deleteTahunAjaran(id) {
    if(!confirm('Yakin ingin menghapus data ini?')) return;
    try {
        const res = await fetch(`/akademik/tahun-ajaran/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if(data.success) location.reload();
        else alert(data.message || 'Gagal menghapus');
    } catch (e) {
        alert('Terjadi kesalahan');
    }
}
</script>

</body>
</html>
