<%- include('../layouts/main') %>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">Data Alumni</h1>
    
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">NIS</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nama</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tahun Lulus</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (alumni.length === 0) { %>
                    <tr><td colspan="4" class="px-6 py-12 text-center text-gray-500">Belum ada data alumni</td></tr>
                <% } %>
                <% alumni.forEach(a => { %>
                    <tr>
                        <td class="px-6 py-4"><%= a.nis %></td>
                        <td class="px-6 py-4"><%= a.nama_lengkap %></td>
                        <td class="px-6 py-4"><%= a.tahun_lulus %></td>
                        <td class="px-6 py-4"><%= a.status_after || 'Alumni' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
