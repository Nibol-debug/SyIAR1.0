/**
 * SyIAR Gemilang - Frontend Server (Express.js)
 * Phase 1-3: Auth, RBAC, Santri Module
 */

require('dotenv').config();
const express = require('express');
const session = require('express-session');
const cookieParser = require('cookie-parser');
const path = require('path');
const axios = require('axios');

const app = express();
const PORT = process.env.PORT || 3000;
const API_BASE_URL = process.env.API_BASE_URL || 'http://localhost:8081/api';

// ============================================
// MIDDLEWARE SETUP
// ============================================

// Body parsing
app.use(express.json());
app.use(express.urlencoded({ extended: true }));
app.use(cookieParser());

// Session configuration
app.use(session({
    secret: process.env.SESSION_SECRET || 'syiar-secret-dev-key',
    resave: false,
    saveUninitialized: false,
    cookie: { 
        httpOnly: true, 
        secure: process.env.NODE_ENV === 'production',
        maxAge: 24 * 60 * 60 * 1000 // 24 hours
    }
}));

// View engine setup
app.set('views', path.join(__dirname, 'src/views'));
app.set('view engine', 'ejs');

// Static files
app.use(express.static(path.join(__dirname, 'src/public')));
app.use('/css', express.static(path.join(__dirname, 'src/public/css')));
app.use('/js', express.static(path.join(__dirname, 'src/public/js')));

// Flash messages middleware
app.use((req, res, next) => {
    res.locals.success = req.session.success;
    res.locals.error = req.session.error;
    res.locals.user = req.session.user || null;
    res.locals.permissions = req.session.permissions || [];
    req.session.success = null;
    req.session.error = null;
    next();
});

// ============================================
// IMPORT MIDDLEWARE & ROUTES
// ============================================

// Import middleware (with error handling)
let authMiddleware, permissionMiddleware;
try {
    authMiddleware = require('./src/middleware/auth');
    permissionMiddleware = require('./src/middleware/permission');
    console.log('✅ Middleware loaded successfully');
} catch (err) {
    console.error('❌ Failed to load middleware:', err.message);
    // Fallback inline middleware if import fails
    authMiddleware = {
        requireAuth: (req, res, next) => {
            if (req.session?.user) return next();
            res.redirect('/login');
        },
        injectUserToViews: (req, res, next) => next()
    };
    permissionMiddleware = (perm) => (req, res, next) => next();
    permissionMiddleware.any = (perms) => (req, res, next) => next();
}

// Import routes (with error handling)
let authRoutes, dashboardRoutes, santriRoutes, roleRoutes;
try {
    authRoutes = require('./src/routes/auth');
    dashboardRoutes = require('./src/routes/dashboard');
    santriRoutes = require('./src/routes/santri');
    roleRoutes = require('./src/routes/roles');
    console.log('✅ Routes loaded successfully');
} catch (err) {
    console.error('❌ Failed to load routes:', err.message);
    // Fallback empty routers
    const express = require('express');
    authRoutes = express.Router();
    dashboardRoutes = express.Router();
    santriRoutes = express.Router();
    roleRoutes = express.Router();
}

// ============================================
// PUBLIC ROUTES
// ============================================

// Health check
app.get('/health', (req, res) => {
    res.json({ status: 'ok', timestamp: new Date().toISOString() });
});

// Login page
app.get('/login', (req, res) => {
    if (req.session?.user) return res.redirect('/dashboard');
    res.render('pages/login', { 
        title: 'Login - SyIAR Gemilang',
        redirect: req.query.redirect || '/dashboard'
    });
});

// Process login
app.post('/login', async (req, res) => {
    try {
        const { username, password } = req.body;
        
        const response = await axios.post(`${API_BASE_URL}/auth/login`, {
            username,
            password
        }, {
            headers: { 'Content-Type': 'application/json' },
            timeout: 10000
        });
        
        const { token, user, permissions } = response.data.data;
        
        // Save to session
        req.session.token = token;
        req.session.user = user;
        req.session.permissions = permissions || [];
        
        req.session.success = `Selamat datang, ${user.nama_lengkap || user.username}!`;
        res.redirect(req.body.redirect || '/dashboard');
        
    } catch (err) {
        console.error('Login error:', err.response?.data || err.message);
        req.session.error = err.response?.data?.message || 'Login gagal. Periksa username/password.';
        res.redirect('/login');
    }
});

// Logout
app.get('/logout', (req, res) => {
    req.session.destroy((err) => {
        if (err) console.error('Logout error:', err);
        res.clearCookie('connect.sid');
        res.redirect('/login');
    });
});

// ============================================
// PROTECTED ROUTES
// ============================================

// Dashboard
app.get('/dashboard', authMiddleware.requireAuth, (req, res) => {
    res.render('pages/dashboard', {
        title: 'Dashboard',
        user: req.session.user,
        permissions: req.session.permissions
    });
});

// Role Management (Phase 2) - only for super_admin
app.get('/admin/roles', authMiddleware.requireAuth, authMiddleware.isSuperAdmin, (req, res) => {
    res.render('pages/role_management', {
        title: 'Manajemen Role',
        user: req.session.user
    });
});

// ============================================
// PHASE 3 MODULE ROUTES
// ============================================

// Santri Module
app.use('/santri', santriRoutes);

// Kelas Module (placeholder)
app.use('/kelas', require('./src/routes/kelas') || express.Router());

// Penilaian Module (placeholder)
app.use('/penilaian', require('./src/routes/penilaian') || express.Router());

// PPDB Module (placeholder)
app.use('/ppdb', require('./src/routes/ppdb') || express.Router());

// ============================================
// ERROR HANDLING
// ============================================

// 404 handler
app.use((req, res) => {
    res.status(404).render('pages/error', {
        title: '404 - Not Found',
        message: 'Halaman yang Anda cari tidak ditemukan',
        code: 404
    });
});

// Global error handler
app.use((err, req, res, next) => {
    console.error('Server error:', err);
    
    if (err.type === 'entity.parse.failed') {
        return res.status(400).json({ error: 'Invalid JSON' });
    }
    
    res.status(err.status || 500).render('pages/error', {
        title: 'Server Error',
        message: process.env.NODE_ENV === 'development' ? err.message : 'Terjadi kesalahan server',
        code: err.status || 500,
        stack: process.env.NODE_ENV === 'development' ? err.stack : undefined
    });
});

// ============================================
// START SERVER
// ============================================

app.listen(PORT, '0.0.0.0', () => {
    console.log(`\n🚀 SyIAR Frontend running on http://localhost:${PORT}`);
    console.log(`📡 API Base URL: ${API_BASE_URL}`);
    console.log(`🔧 Environment: ${process.env.NODE_ENV || 'development'}\n`);
});

// Graceful shutdown
process.on('SIGINT', () => {
    console.log('\n👋 Shutting down gracefully...');
    process.exit(0);
});

module.exports = app;
